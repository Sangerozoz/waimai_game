+ g.acceptBatch(candidates);capture('planned');g.beginTrip(g.routeChoices()[0].preference);
+ let now=g.snapshot().frame.nowSeconds,sequence=g.snapshot().frame.sequence;
+ for(let i=0;i<3000&&g.snapshot().batchIds.length;i++){
+  capture(g.route.progress.phase);
+  if(g.snapshot().orders.filter(o=>g.snapshot().batchIds.includes(o.id)&&o.status==='completed').length===1)capture('partial');
+  if(g.route.progress.phase==='pickup')g.pickup();else if(g.route.progress.phase==='ready')g.continueTrip();else g.tick(++sequence,now+=.5,true,false);
+ }
+ assert.equal(g.snapshot().batchIds.length,0);capture('finished');
+ for(const name of ['borrowed','planned','pickup','ready','travelling','service','partial','finished'])assert.ok(stages.has(name),name);
+ for(const [name,{raw,route}] of stages){
