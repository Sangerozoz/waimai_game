+   assert.equal(r.snapshot.frame.nowSeconds,f.now,name);assert.deepEqual(r.routeSnapshot,route,name);assert.deepEqual(r.tripState,before.tripState,name);
+   assert.deepEqual(r.snapshot.orders,before.dispatch.orders,name);assert.deepEqual(r.snapshot.batchIds,before.dispatch.batchIds,name);
+   const old=before.dispatch.economy.state,current=r.snapshot.economy.state,oldFleet=before.dispatch.fleet.fleet,currentFleet=r.snapshot.fleet.fleet;
+   const {ledgerContext:oldContext,cashCents:oldCash,npcCompletedOrders:oldCount,fleetQuotes:oldQuotes,settledOrderIds:oldPaid,ledger:oldLedger,...oldState}=old;
+   const {ledgerContext:currentContext,cashCents:currentCash,npcCompletedOrders:currentCount,fleetQuotes:currentQuotes,settledOrderIds:currentPaid,ledger:currentLedger,...currentState}=current;
+   assert.equal(currentContext.nowMs,f.now*1000,name);assert.deepEqual(currentState,oldState,name);assert.equal(r.snapshot.economy.version,before.dispatch.economy.version,name);
+   const work=Math.min(oldFleet.quotaMs,Math.max(0,f.now*1000-oldFleet.lastAdvancedAt));
+   const payable=oldFleet.batches.flatMap(batch=>batch.orders.slice(batch.paidCount).filter(order=>order.dueMs<=batch.elapsedMs+work));
+   const paidIds=new Set(payable.map(order=>order.id));
+   assert.equal(currentCash,oldCash+payable.reduce((sum,order)=>sum+order.incomeCents,0),name);assert.equal(currentCount,oldCount+payable.length,name);
+   assert.deepEqual(currentQuotes,oldQuotes.filter(order=>!paidIds.has(order.id)),name);
+   assert.deepEqual(currentLedger.entries.slice(0,oldLedger.entries.length),oldLedger.entries,name);assert.deepEqual(currentLedger.opening,oldLedger.opening,name);assert.equal(currentLedger.nextId,oldLedger.nextId,name);
+   const added=currentLedger.entries.slice(oldLedger.entries.length);assert.equal(added.length,payable.length,name);
